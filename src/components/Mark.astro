---
// The Alba mark: two domes rising on one horizon. The solid one is Lina, the open one is
// the person she cares for; where they overlap, first light. `--we` is the gap between them
// (0 = met, the canonical logo; 1 = a full step apart). src/motion/we.ts drives it.
interface Props {
  mode?: 'scroll' | 'still' | 'reveal';
  we?: number;
  class?: string;
  title?: string;
}
const { mode = 'still', we = 0, class: cls = '', title } = Astro.props;
const uid = `m${Math.random().toString(36).slice(2, 8)}`;
const solid = 'M16 60a30 30 0 0 1 60 0z';
const open = 'M44 60a30 30 0 0 1 60 0';
---
<svg
  class:list={['mark', cls]}
  viewBox="0 0 120 64"
  data-we={mode}
  style={`--we:${we}`}
  data-we-base={we}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <clipPath id={uid}><path class="mark__solid" d={solid} /></clipPath>
  </defs>
  <path class="mark__solid mark__fill" d={solid} />
  <g clip-path={`url(#${uid})`}><path class="mark__open mark__lens" d={`${open}z`} /></g>
  <path class="mark__open mark__stroke" d={open} />
  <path class="mark__horizon" d="M2 60h116" />
</svg>
