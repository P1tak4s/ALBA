---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absolute, dicts, href, locales, site, type Locale, type PageKey } from '../i18n';
import { areas, areaHref } from '../i18n/areas';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  locale: Locale;
  page: PageKey | null;      // null for the 404
  title: string;
  description: string;
  crumb?: string;            // breadcrumb label for inner pages
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  finale?: boolean;
  path?: string;             // canonical path for English-only pages outside PageKey (areas, guides)
  parent?: { name: string; path: string }; // middle breadcrumb for those pages
  pageType?: string;         // schema.org type of the page node, WebPage by default
}
const { locale, page, title, description, crumb, schema = [], noindex = false, finale = true, path, parent, pageType } = Astro.props;
const d = dicts[locale];
const t = d.common;
const fullTitle = `${title} | ${t.brand}`;
const canonical = page ? absolute(href(locale, page)) : path ? absolute(path) : undefined;
const ogImage = absolute('/og.png');
const hreflang: Record<Locale, string> = { en: 'en-GB', lt: 'lt-LT', ru: 'ru' };

const business = {
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${site.url}/#business`,
  name: 'Alba Wellbeing',
  alternateName: ['ALBA Wellbeing', 'Alba'],
  description: dicts.en.pages.home.description,
  slogan: dicts.en.common.motto,
  url: `${site.url}/`,
  telephone: '+44 7300 403632',
  email: site.email,
  image: ogImage,
  logo: absolute('/icon-512.png'),
  founder: { '@id': `${site.url}/#lina` },
  address: { '@type': 'PostalAddress', addressLocality: 'Louth', addressRegion: 'Lincolnshire', addressCountry: 'GB' },
  geo: { '@type': 'GeoCoordinates', latitude: 53.3669, longitude: -0.0061 },
  areaServed: [
    { '@type': 'Country', name: 'England' },
    { '@type': 'Country', name: 'United Kingdom' },
    ...areas.map((a) => ({ '@type': 'AdministrativeArea', name: a.name, url: absolute(areaHref(a.slug)) })),
  ],
  knowsAbout: ['Live-in care', 'Companionship care', 'Dementia care', 'Parkinson’s disease care', 'Stroke rehabilitation support', 'Palliative care', 'End-of-life companionship', 'Hypnotherapy', 'Therapeutic massage', 'Reiki'],
  knowsLanguage: ['en', 'lt', 'ru'],
  availableLanguage: ['English', 'Lithuanian', 'Russian'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Care and wellbeing services',
    itemListElement: (['liveIn', 'reset', 'endOfLife', 'hypno'] as const).map((k) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: dicts.en.pages[k].serviceName, url: absolute(href('en', k)) },
    })),
  },
};
const person = {
  '@type': 'Person',
  '@id': `${site.url}/#lina`,
  name: 'Lina Simavičiūtė',
  alternateName: 'Alba',
  jobTitle: 'Live-in carer and wellbeing companion',
  description: dicts.en.pages.about.lead,
  worksFor: { '@id': `${site.url}/#business` },
  url: absolute(href('en', 'about')),
  image: absolute('/lina.jpg'),
  knowsLanguage: ['en', 'lt', 'ru'],
  telephone: '+44 7300 403632',
  email: site.email,
};
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: 'Alba Wellbeing', inLanguage: locales.map((l) => hreflang[l]), publisher: { '@id': `${site.url}/#business` } },
  business,
  person,
];
if (canonical) {
  graph.push({
    '@type': pageType ?? (page === 'about' ? 'AboutPage' : page === 'contact' ? 'ContactPage' : 'WebPage'),
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description,
    inLanguage: hreflang[locale],
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': page === 'about' ? `${site.url}/#lina` : `${site.url}/#business` },
    primaryImageOfPage: ogImage,
    ...(crumb ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
  });
  if (crumb) graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.breadcrumbHome, item: absolute(href(locale, 'home')) },
      ...(parent ? [{ '@type': 'ListItem', position: 2, name: parent.name, item: absolute(parent.path) }] : []),
      { '@type': 'ListItem', position: parent ? 3 : 2, name: crumb, item: canonical },
    ],
  });
}
graph.push(...schema);
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang={hreflang[locale]} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {page && locales.map((l) => <link rel="alternate" hreflang={hreflang[l]} href={absolute(href(l, page))} />)}
    {page && <link rel="alternate" hreflang="x-default" href={absolute(href('en', page))} />}
    <meta name="theme-color" content="#f6f5f1" />
    <meta name="author" content="Lina Simavičiūtė" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:locale" content={d.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t.brand}: ${t.motto}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/literata-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/onest-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Before first paint: flag JS + motion so hidden-until-revealed states never flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__panel curtain__panel--l"></div>
      <div class="curtain__panel curtain__panel--r"></div>
      <div class="curtain__seam"></div>
    </div>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} finale={finale} />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
